@page "/"

<style>
    .ee-test-div {
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        border: solid 1px red;
        width: 125px;
    }
</style>

<MudPaper Class="pa-7 mt-10 mx-auto" MaxWidth="1200px;" Elevation="2">
    <MudImage Src="/images/find_something_borderless.png" Alt="Find Gear" Fluid="true" Class="mb-0" />
    <MudContainer>
        <MudTextField Margin="Margin.Dense" @bind-Value="@SearchString" Label="Search"  Variant="Variant.Outlined" OnKeyUp="SearchChanged" />
        <MudButton Class="mt-1" FullWidth="true" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Search" Color="Color.Dark">GO!</MudButton>
    </MudContainer>
</MudPaper>


<MudPaper Class="pt-3 pb-7 px-7 mt-5 mx-auto" MaxWidth="1200px;" Elevation="2">
    <MudTabs Elevation="0" Outlined="false" ApplyEffectsToContainer="true" PanelClass="pa-0">
        <MudTabPanel Text="Trending">
            <div class="ee-main-list">
                @foreach(var item in ProductTrending) {
                    string image = Program.ImageAsset + item.Folder + "/" + item.Image + item.ImageExtension;
                    <div class="ee-main-list-wrapper" style="cursor:pointer" @onclick="@(() => GoToProduct(item.Id))">
                        <div class="ee-main-list-header">@item.Name</div>
                        <div class="ee-main-list-image"><MudImage ObjectFit="ObjectFit.Contain" Width="135" Height="135" Src="@image" Elevation="3" Alt="@item.ImageName" /></div>
                        <div class="ee-main-list-price">@item.Price.ToString("C2")</div>
                        <div class="ee-main-list-condition">@item.ConditionDescription</div>
                    </div>
                }
            </div>
        </MudTabPanel>
    </MudTabs>
</MudPaper>


<MudPaper Class="pa-7 mt-5 mx-auto" MaxWidth="1200px;" Elevation="2">
    <MudCarousel Class="mud-width-full" Style="height:200px;" ShowArrows="true" ShowBullets="true" EnableSwipeGesture="true" AutoCycle="true" TData="object">
        <MudCarouselItem Transition="Transition.Slide" Color="@Color.Primary">
            <div class="d-flex" style="height:100%">
                <MudIcon Class="mx-auto my-auto" Icon="@Icons.Custom.Brands.MudBlazor" Size="@Size.Large" />
            </div>
        </MudCarouselItem>
        <MudCarouselItem Transition="Transition.Slide" Color="@Color.Secondary">
            <div class="d-flex" style="height:100%">
                <MudIcon Class="mx-auto my-auto" Icon="@Icons.Custom.Brands.MudBlazor" Size="@Size.Large" />
            </div>
        </MudCarouselItem>
        <MudCarouselItem Transition="Transition.Slide">
            <div class="d-flex" style="height:100%">
                <MudIcon Class="mx-auto my-auto" Icon="@Icons.Custom.Brands.MudBlazor" Color="@Color.Primary" Size="@Size.Large" />
            </div>
        </MudCarouselItem>
    </MudCarousel>
</MudPaper>



<MudPaper Class="pt-3 pb-7 px-7 mt-5 mx-auto" MaxWidth="1200px;" Elevation="2">
    <MudTabs Elevation="0" Outlined="false" ApplyEffectsToContainer="true" PanelClass="pa-0">
        <MudTabPanel Text="Recently Viewed">
            <div class="ee-main-list">
                @foreach (var item in ProductView) {
                    string image = Program.ImageAsset + item.Folder + "/" + item.Image + item.ImageExtension;
                    <div class="ee-main-list-wrapper" style="cursor:pointer" @onclick="@(() => GoToProduct(item.Id))">
                        <div class="ee-main-list-header">@item.Name</div>
                        <div class="ee-main-list-image"><MudImage ObjectFit="ObjectFit.Contain" Width="135" Height="135" Src="@image" Elevation="3" Alt="@item.ImageName" /></div>
                        <div class="ee-main-list-price">@item.Price.ToString("C2")</div>
                        <div class="ee-main-list-condition">@item.ConditionDescription</div>
                    </div>
                }
            </div>
        </MudTabPanel>
    </MudTabs>
</MudPaper>


